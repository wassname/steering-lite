            case_prompts={transfer_case.case_id: [_record(f"SYN-{number:03d}", prompt, "audited-synthetic") for number, prompt in enumerate(transfer_prompts, 1)]}, prompt_spec={"max_new_tokens": 8},
            transfer_cases=(transfer_case,),
        )
    
